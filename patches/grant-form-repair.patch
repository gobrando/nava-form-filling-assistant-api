+def generic_overlap(entry, label):
+    """A mapper that scores every shared token, including number and id."""
+    strong, weak = field_repair.entry_words(entry)
+    observed = field_repair.tokenize(label)
+    return len(strong & observed) * 10 + len(weak & observed)
