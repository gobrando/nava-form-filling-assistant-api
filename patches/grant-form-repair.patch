+    def test_cli_dry_run_prints_a_proposal_and_does_not_write(self):
+        before = PLAYBOOK.read_bytes()
+        playbooks = sorted(path.name for path in PLAYBOOK.parent.glob("*"))
+        completed = subprocess.run(
+            [
+                str(ROOT / "bin/grant-filler"),
+                "repair-fields",
+                str(PLAYBOOK),
+                str(FIXTURES / "renamed-ids.json"),
+            ],
+            check=False,
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        proposal = json.loads(completed.stdout)
+        self.assertTrue(proposal["publishable"])
+        self.assertEqual(proposal["submission"], "never")
+        self.assertEqual(PLAYBOOK.read_bytes(), before)
+        self.assertEqual(sorted(path.name for path in PLAYBOOK.parent.glob("*")), playbooks)
+
+        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as handle:
+            json.dump([{
+                "selector": "#ein",
+                "label": "EIN",
+                "type": "text",
+                "count": 1,
+                "value": "12-3456789",
+            }], handle)
+            valued = Path(handle.name)
+        try:
+            rejected = subprocess.run(
+                [sys.executable, str(BATCH_PATH), "repair-fields", str(PLAYBOOK), str(valued)],
+                check=False,
+                capture_output=True,
+                text=True,
+            )
+        finally:
+            valued.unlink()
+        self.assertEqual(rejected.returncode, 2)
+        self.assertIn("value", rejected.stderr.lower())
+        self.assertNotIn("12-3456789", rejected.stdout)
+        self.assertEqual(PLAYBOOK.read_bytes(), before)
