diff --git a/skills/agentic-grant-application/scripts/field_repair.py b/skills/agentic-grant-application/scripts/field_repair.py
new file mode 100644
index 0000000..e7f4d06
--- /dev/null
+++ b/skills/agentic-grant-application/scripts/field_repair.py
@@ -0,0 +1,628 @@
+#!/usr/bin/env python3
+"""Deterministic repair for a grant portal field map. No model and no values.
+
+A generic form mapper scores overlapping words and will park a bank account on
+"reference number" because both say "number", or treat "award" as enough to
+name an award amount. Grant repair does not.
+
+EIN, SSN, bank account, and award amount move only when a label clearly names
+that field. Project id, case number, and reference number are nearby
+identifiers: they can keep a field whose purpose is that identifier, and they
+never receive a protected field. Any other field also stays off those labels,
+so "project title" cannot fall through onto "project id".
+
+A selector that still matches one compatible control is kept. Anything else
+moves only when one control scores strictly above the others. A tie, a dropped
+field, or a protected field without a clear label blocks the proposal. The
+proposal is the whole result. This module does not write a playbook and it
+never submits a form.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+from typing import Any, Mapping, Optional, Sequence, Union
+
+
+class ObservationError(ValueError):
+    """The caller passed something other than redacted controls."""
+
+
+OBSERVED_KEYS = {"selector", "label", "type", "count"}
+OBSERVATION_KEYS = {"controls", "previous", "description"}
+CARRIED_KEYS = ("purpose", "label", "type", "required", "method", "mask")
+
+# Words that show up on too many grant controls to name one.
+GENERIC_WEAK = frozenset({"number", "id", "name", "code", "type", "status", "federal", "funding"})
+
+STOP = frozenset({
+    "the", "and", "for", "with", "your", "you", "what", "this", "that", "from",
+    "does", "have", "has", "please", "are", "was", "not", "but", "can",
+})
+
+ACRONYMS = frozenset({"id", "ein", "ssn", "uei", "dba", "sam", "iban"})
+
+# Tokens that clearly name a protected grant field. "Award" is absent on
+# purpose: an award number is an identifier, not the dollars requested.
+CLEAR = {
+    "ein": frozenset({"ein", "employer", "tax"}),
+    "ssn": frozenset({"ssn", "social", "security"}),
+    "bank_account": frozenset({"bank", "routing", "iban"}),
+    "award_amount": frozenset({"amount", "requested"}),
+}
+
+# What a generic overlap mapper would treat as the same field. Protected
+# placement ignores these unless a CLEAR token is also present.
+SENSITIVE_WEAK = {
+    "ein": frozenset({"identification", "number", "id"}),
+    "ssn": frozenset({"number", "id"}),
+    "bank_account": frozenset({"account", "number", "id"}),
+    "award_amount": frozenset({"award", "number", "id", "federal", "funding"}),
+}
+
+PROTECTED = frozenset(CLEAR)
+
+PURPOSE_ALIASES = {
+    "ein": "ein",
+    "ssn": "ssn",
+    "socialsecuritynumber": "ssn",
+    "bankaccount": "bank_account",
+    "bankaccountnumber": "bank_account",
+    "awardamount": "award_amount",
+    "requestedamount": "award_amount",
+    "federalamountrequested": "award_amount",
+}
+
+IDENTIFIER_FIELDS = {
+    "project id": "project_id",
+    "case number": "case_number",
+    "reference number": "reference_number",
+}
+
+NEARBY_IDENTIFIER_RE = re.compile(
+    r"\b(?:project\s+id|case\s+number|reference\s+number)\b",
+    re.IGNORECASE,
+)
+SUBMIT_RE = re.compile(r"submit|certif|captcha|signature|password|\bsign\b", re.IGNORECASE)
+FIELD_MAP_RE = re.compile(
+    r"^## Field map\b.*?```json\n(.*?)\n```",
+    re.MULTILINE | re.DOTALL,
+)
+CAMEL_RE = re.compile(r"([a-z])([A-Z])")
+
+TEXTISH = frozenset({"text", "textarea", "number", "email", "tel"})
+CHOICES = frozenset({"radio", "select"})
+
+
+def canonical_purpose(purpose: Optional[str]) -> Optional[str]:
+    if not purpose:
+        return None
+    compact = re.sub(r"[^a-z0-9]", "", purpose.lower())
+    return PURPOSE_ALIASES.get(compact, purpose)
+
+
+def is_protected(purpose: Optional[str]) -> bool:
+    return canonical_purpose(purpose) in PROTECTED
+
+
+def tokenize(value: str) -> set[str]:
+    words = re.findall(r"[a-z0-9]+", value.lower())
+    return {
+        word
+        for word in words
+        if word in ACRONYMS or (len(word) >= 3 and word not in STOP)
+    }
+
+
+def nearby_identifier(label: str) -> bool:
+    return NEARBY_IDENTIFIER_RE.search(label or "") is not None
+
+
+def normalize_label(value: str) -> str:
+    return re.sub(r"\s+", " ", value or "").strip().casefold()
+
+
+def purpose_words(purpose: Optional[str]) -> str:
+    if not purpose:
+        return ""
+    spaced = purpose.replace("_", " ")
+    return CAMEL_RE.sub(r"\1 \2", spaced)
+
+
+def entry_words(entry: Mapping[str, Any]) -> tuple[set[str], set[str]]:
+    """Distinctive tokens, then generic ones a careless mapper would still score."""
+    purpose = canonical_purpose(entry.get("purpose"))
+    tokens = tokenize(f"{entry.get('label') or ''} {purpose_words(purpose)}")
+    if purpose in CLEAR:
+        strong = set(CLEAR[purpose])
+        weak = (set(SENSITIVE_WEAK[purpose]) | (tokens & GENERIC_WEAK)) - strong
+        return strong, weak
+    strong = {token for token in tokens if token not in GENERIC_WEAK}
+    weak = {token for token in tokens if token in GENERIC_WEAK}
+    return strong, weak
+
+
+def _identifier_named(entry: Mapping[str, Any], label: str) -> bool:
+    """True when this field is the identifier the label is announcing."""
+    match = NEARBY_IDENTIFIER_RE.search(label or "")
+    if not match:
+        return False
+    expected = IDENTIFIER_FIELDS[normalize_label(match.group(0))]
+    purpose = canonical_purpose(entry.get("purpose")) or ""
+    compact = re.sub(r"[^a-z0-9]", "", purpose.lower())
+    return compact == expected.replace("_", "")
+
+
+def normalize_type(value: str) -> str:
+    lowered = (value or "text").lower()
+    if lowered in {"email", "tel"}:
+        return "text"
+    if lowered == "select-one":
+        return "select"
+    return lowered
+
+
+def types_compatible(left: str, right: str) -> bool:
+    first = normalize_type(left)
+    second = normalize_type(right)
+    if first == second:
+        return True
+    if first in TEXTISH and second in TEXTISH:
+        return True
+    return first in CHOICES and second in CHOICES
+
+
+def is_blocked(control: Mapping[str, Any], never_submit: set[str]) -> bool:
+    if control["selector"] in never_submit:
+        return True
+    if normalize_type(str(control.get("type") or "")) in {"submit", "password"}:
+        return True
+    text = f"{control.get('selector', '')} {control.get('label', '')} {control.get('type', '')}"
+    return SUBMIT_RE.search(text) is not None
+
+
+def _require_text(item: Mapping[str, Any], key: str, where: str) -> str:
+    value = item.get(key)
+    if not isinstance(value, str) or not value.strip():
+        raise ObservationError(f"{where} needs a {key}")
+    return value.strip()
+
+
+def parse_controls(raw: Any) -> list[dict[str, Any]]:
+    if not isinstance(raw, list):
+        raise ObservationError("controls must be a list")
+    parsed: list[dict[str, Any]] = []
+    seen: set[str] = set()
+    for index, item in enumerate(raw):
+        where = f"controls[{index}]"
+        if not isinstance(item, dict):
+            raise ObservationError(f"{where} must be an object")
+        if "value" in item:
+            raise ObservationError("observed controls must not include a value")
+        extra = set(item) - OBSERVED_KEYS
+        if extra:
+            names = ", ".join(sorted(extra))
+            raise ObservationError(f"{where} has unexpected fields: {names}")
+        selector = _require_text(item, "selector", where)
+        if selector in seen:
+            raise ObservationError(f"duplicate selector {selector}")
+        seen.add(selector)
+        label = item.get("label")
+        control_type = item.get("type")
+        count = item.get("count")
+        if not isinstance(label, str):
+            raise ObservationError(f"{where} needs a label")
+        if not isinstance(control_type, str) or not control_type.strip():
+            raise ObservationError(f"{where} needs a type")
+        if type(count) is not int or isinstance(count, bool) or count < 0 or count > 50:
+            raise ObservationError(f"{where} count must be an integer from 0 to 50")
+        parsed.append({
+            "selector": selector,
+            "label": label.strip(),
+            "type": control_type.strip(),
+            "count": count,
+        })
+    return parsed
+
+
+def _reject_values(entry: Mapping[str, Any], where: str) -> None:
+    if "value" in entry:
+        raise ObservationError(f"{where} must not include a value")
+
+
+def parse_previous(raw: Mapping[str, Any]) -> dict[str, Any]:
+    if "value" in raw:
+        raise ObservationError("a field map must not include a value")
+    field_map = raw.get("field_map")
+    if not isinstance(field_map, list) or not field_map:
+        raise ObservationError("previous field map needs field_map")
+    entries: list[dict[str, Any]] = []
+    for index, entry in enumerate(field_map):
+        where = f"field_map[{index}]"
+        if not isinstance(entry, dict):
+            raise ObservationError(f"{where} must be an object")
+        _reject_values(entry, where)
+        selector = _require_text(entry, "selector", where)
+        label = entry.get("label")
+        control_type = entry.get("type")
+        if not isinstance(label, str) or not label.strip():
+            raise ObservationError(f"{where} needs a label")
+        if not isinstance(control_type, str) or not control_type.strip():
+            raise ObservationError(f"{where} needs a type")
+        cleaned = {
+            "selector": selector,
+            "label": label.strip(),
+            "type": control_type.strip(),
+            "purpose": entry.get("purpose"),
+            "required": bool(entry.get("required")),
+        }
+        for key in ("method", "mask"):
+            if isinstance(entry.get(key), str) and entry[key].strip():
+                cleaned[key] = entry[key].strip()
+        entries.append(cleaned)
+    probes = []
+    for probe in raw.get("probes") or []:
+        if isinstance(probe, str) and probe.strip():
+            probes.append({"selector": probe.strip(), "label": "", "type": ""})
+        elif isinstance(probe, dict) and isinstance(probe.get("selector"), str):
+            _reject_values(probe, "probe")
+            probes.append({
+                "selector": probe["selector"].strip(),
+                "label": str(probe.get("label") or "").strip(),
+                "type": str(probe.get("type") or "").strip(),
+            })
+    never = raw.get("never_submit") or []
+    if not isinstance(never, list) or not all(isinstance(item, str) for item in never):
+        raise ObservationError("never_submit must be a list of selectors")
+    return {
+        "domain": raw.get("domain"),
+        "version": raw.get("version"),
+        "name": raw.get("name"),
+        "probes": probes,
+        "field_map": entries,
+        "never_submit": list(never),
+    }
+
+
+def load_playbook(path: Union[str, Path]) -> dict[str, Any]:
+    text = Path(path).read_text(encoding="utf-8")
+    match = FIELD_MAP_RE.search(text)
+    if not match:
+        raise ObservationError(f"No field map JSON under '## Field map' in {path}")
+    try:
+        payload = json.loads(match.group(1))
+    except json.JSONDecodeError as exc:
+        raise ObservationError(f"Field map JSON could not be parsed: {exc}") from exc
+    if not isinstance(payload, dict):
+        raise ObservationError("field map JSON must be an object")
+    return parse_previous(payload)
+
+
+def split_observation(payload: Any) -> tuple[Optional[dict[str, Any]], list[dict[str, Any]]]:
+    if isinstance(payload, list):
+        return None, parse_controls(payload)
+    if not isinstance(payload, dict):
+        raise ObservationError("observation must be a control list or an object")
+    if "value" in payload:
+        raise ObservationError("observation must not include a value")
+    extra = set(payload) - OBSERVATION_KEYS
+    if extra:
+        names = ", ".join(sorted(extra))
+        raise ObservationError(f"observation has unexpected fields: {names}")
+    if "controls" not in payload:
+        raise ObservationError("observation needs controls")
+    previous = payload.get("previous")
+    parsed_previous = None
+    if previous is not None:
+        if not isinstance(previous, dict):
+            raise ObservationError("previous must be an object")
+        parsed_previous = parse_previous(previous)
+    return parsed_previous, parse_controls(payload["controls"])
+
+
+def score_pair(entry: Mapping[str, Any], control: Mapping[str, Any]) -> int:
+    """How strongly this control's label names the previous field.
+
+    Nearby identifiers score zero unless the field is that identifier.
+    Protected fields otherwise need a clear token, never "number" or "id" alone.
+    """
+    label = str(control.get("label") or "")
+    if nearby_identifier(label) and not _identifier_named(entry, label):
+        return 0
+    strong_words, weak_words = entry_words(entry)
+    observed = tokenize(label)
+    strong = len(strong_words & observed)
+    weak = len(weak_words & observed)
+    if is_protected(entry.get("purpose")) and strong == 0:
+        return 0
+    if strong == 0:
+        return 0
+    return strong * 10 + weak
+
+
+def _is_required(entry: Mapping[str, Any]) -> bool:
+    return bool(entry.get("required")) or is_protected(entry.get("purpose"))
+
+
+def _carry(entry: Mapping[str, Any], control: Mapping[str, Any], moved: bool) -> dict[str, Any]:
+    purpose = canonical_purpose(entry.get("purpose")) if entry.get("purpose") else None
+    carried: dict[str, Any] = {
+        "selector": control["selector"],
+        "purpose": purpose,
+        "label": control["label"] if moved else entry["label"],
+        "type": control["type"] if moved else entry["type"],
+        "required": _is_required(entry),
+    }
+    for key in ("method", "mask"):
+        if entry.get(key):
+            carried[key] = entry[key]
+    return {key: carried[key] for key in ("selector",) + CARRIED_KEYS if key in carried}
+
+
+def _placement(
+    entry: Mapping[str, Any],
+    to_selector: Optional[str],
+    disposition: str,
+    reason: str,
+) -> dict[str, Any]:
+    return {
+        "purpose": canonical_purpose(entry.get("purpose")) if entry.get("purpose") else None,
+        "from_selector": entry["selector"],
+        "to_selector": to_selector,
+        "disposition": disposition,
+        "reason": reason,
+        "input_type": entry["type"],
+        "required": _is_required(entry),
+    }
+
+
+def _tie_label(controls: Sequence[Mapping[str, Any]]) -> Optional[str]:
+    groups: dict[str, list[str]] = {}
+    for control in controls:
+        groups.setdefault(normalize_label(control["label"]), []).append(control["label"])
+    for names in groups.values():
+        if len(names) > 1:
+            return names[0]
+    return None
+
+
+def _label_blocks_keep(entry: Mapping[str, Any], control: Mapping[str, Any]) -> bool:
+    """A stable id does not keep a protected field that now reads as an identifier."""
+    if not is_protected(entry.get("purpose")):
+        return False
+    return nearby_identifier(str(control.get("label") or "")) and not _identifier_named(entry, control["label"])
+
+
+def propose_repair(previous: Mapping[str, Any], observed: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    """Place the previous field map onto observed controls and return a proposal.
+
+    Does not write a file. Does not submit. A refused proposal carries an empty
+    field map so a caller cannot publish a partial repair by accident.
+    """
+    previous_map = parse_previous(dict(previous))
+    controls = parse_controls(list(observed))
+    never = set(previous_map["never_submit"])
+    blocked = [
+        {
+            "selector": control["selector"],
+            "label": control["label"],
+            "reason": "Legal-effect or submit control. Not a fill target.",
+        }
+        for control in controls
+        if is_blocked(control, never)
+    ]
+    usable = [
+        control
+        for control in controls
+        if control["count"] == 1 and not is_blocked(control, never)
+    ]
+    by_selector = {control["selector"]: control for control in controls}
+    claimed: set[int] = set()
+    kept: list[dict[str, Any]] = []
+    pending: list[dict[str, Any]] = []
+
+    for entry in previous_map["field_map"]:
+        if is_blocked(
+            {"selector": entry["selector"], "label": entry["label"], "type": entry["type"]},
+            never,
+        ):
+            continue
+        found = by_selector.get(entry["selector"])
+        if (
+            found
+            and found["count"] == 1
+            and not is_blocked(found, never)
+            and types_compatible(entry["type"], found["type"])
+            and not _label_blocks_keep(entry, found)
+        ):
+            at = usable.index(found) if found in usable else -1
+            if at >= 0:
+                claimed.add(at)
+            kept.append(_placement(
+                entry,
+                entry["selector"],
+                "kept",
+                "The previous selector still resolves to one control.",
+            ))
+            continue
+        pending.append(entry)
+
+    pairs: list[tuple[int, int, int]] = []
+    for field_index, entry in enumerate(pending):
+        for control_index, control in enumerate(usable):
+            if control_index in claimed:
+                continue
+            if not types_compatible(entry["type"], control["type"]):
+                continue
+            score = score_pair(entry, control)
+            if score > 0:
+                pairs.append((field_index, control_index, score))
+
+    moved: list[dict[str, Any]] = []
+    moved_from: set[int] = set()
+    for field_index, control_index, score in pairs:
+        field_scores = [item[2] for item in pairs if item[0] == field_index]
+        control_scores = [item[2] for item in pairs if item[1] == control_index]
+        if score != max(field_scores) or score != max(control_scores):
+            continue
+        if field_scores.count(score) != 1 or control_scores.count(score) != 1:
+            continue
+        entry = pending[field_index]
+        control = usable[control_index]
+        moved_from.add(field_index)
+        claimed.add(control_index)
+        moved.append(_placement(
+            entry,
+            control["selector"],
+            "moved",
+            f'The label "{control["label"]}" is the only control that still names this field.',
+        ))
+
+    unresolved: list[dict[str, Any]] = []
+    for field_index, entry in enumerate(pending):
+        if field_index in moved_from:
+            continue
+        field_pairs = [(score, usable[index]) for owner, index, score in pairs if owner == field_index]
+        best = max((score for score, _control in field_pairs), default=0)
+        best_controls = [control for score, control in field_pairs if score == best] if best else []
+        shared = _tie_label(best_controls)
+        if shared:
+            reason = f'Tie: two controls share the label "{shared}".'
+        else:
+            purpose = canonical_purpose(entry.get("purpose")) if entry.get("purpose") else None
+            name = purpose or entry["selector"]
+            if purpose and is_protected(purpose):
+                reason = f"Refused to guess {purpose}. No unique label names this field."
+            else:
+                reason = f"No unique label match for {name}. Left unmapped rather than guessed."
+        unresolved.append(_placement(entry, None, "unresolved", reason))
+
+    placed = {item["from_selector"]: item for item in kept + moved}
+    claimed_selectors = {item["to_selector"] for item in kept + moved}
+    unmapped = [
+        {
+            "selector": control["selector"],
+            "label": control["label"],
+            "reason": "On the page, and not claimed by the previous field map.",
+        }
+        for control in usable
+        if control["selector"] not in claimed_selectors
+    ]
+
+    field_map = []
+    for entry in previous_map["field_map"]:
+        placement = placed.get(entry["selector"])
+        if not placement or not placement["to_selector"]:
+            continue
+        control = by_selector[placement["to_selector"]]
+        field_map.append(_carry(entry, control, placement["disposition"] == "moved"))
+
+    probes = _repair_probes(previous_map["probes"], placed, controls, never)
+    refused = _refusal(unresolved, field_map, probes)
+    return {
+        "publishable": refused is None,
+        "refused": refused,
+        "submission": "never",
+        "kept": kept,
+        "moved": moved,
+        "unresolved": unresolved,
+        "unmapped": unmapped,
+        "blocked": blocked,
+        "probes": probes if refused is None else [],
+        "field_map": field_map if refused is None else [],
+    }
+
+
+def _repair_probes(
+    probes: Sequence[Mapping[str, Any]],
+    placed: Mapping[str, Mapping[str, Any]],
+    controls: Sequence[Mapping[str, Any]],
+    never_submit: set[str],
+) -> list[str]:
+    by_selector = {control["selector"]: control for control in controls}
+    result: list[str] = []
+    for probe in probes:
+        selector = probe["selector"]
+        placement = placed.get(selector)
+        if placement and placement.get("to_selector"):
+            result.append(placement["to_selector"])
+            continue
+        found = by_selector.get(selector)
+        if found and found["count"] == 1 and not is_blocked(found, never_submit):
+            result.append(selector)
+            continue
+        label = normalize_label(str(probe.get("label") or ""))
+        if not label:
+            continue
+        matches = []
+        for control in controls:
+            if control["count"] != 1 or is_blocked(control, never_submit):
+                continue
+            if normalize_label(control["label"]) != label:
+                continue
+            probe_type = str(probe.get("type") or "")
+            if probe_type and not types_compatible(probe_type, control["type"]):
+                continue
+            matches.append(control["selector"])
+        if len(matches) == 1:
+            result.append(matches[0])
+    ordered: list[str] = []
+    for selector in result:
+        if selector not in ordered:
+            ordered.append(selector)
+    return ordered
+
+
+def _refusal(
+    unresolved: Sequence[Mapping[str, Any]],
+    field_map: Sequence[Mapping[str, Any]],
+    probes: Sequence[str],
+) -> Optional[str]:
+    if unresolved:
+        names = [item.get("purpose") or item["from_selector"] for item in unresolved]
+        protected = [str(name) for name in names if name and is_protected(str(name))]
+        shown = ", ".join(str(name) for name in names)
+        if protected:
+            blocked = ", ".join(protected)
+            return (
+                f"Refused to guess {blocked}. "
+                f"{len(unresolved)} field(s) had no unique label match ({shown})."
+            )
+        return f"{len(unresolved)} field(s) had no unique label match ({shown})."
+    if not field_map:
+        return "No field could be carried forward."
+    if not probes:
+        return "The repair produced no freshness probe."
+    return None
+
+
+def dry_run(playbook_path: Union[str, Path], observation_path: Union[str, Path]) -> dict[str, Any]:
+    """Read a playbook and an observation. Return a proposal. Write nothing."""
+    playbook = load_playbook(playbook_path)
+    payload = json.loads(Path(observation_path).read_text(encoding="utf-8"))
+    embedded, controls = split_observation(payload)
+    previous = embedded if embedded is not None else playbook
+    return propose_repair(previous, controls)
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    import argparse
+    import sys
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("playbook")
+    parser.add_argument("observation")
+    args = parser.parse_args(list(argv) if argv is not None else None)
+    try:
+        proposal = dry_run(args.playbook, args.observation)
+    except ObservationError as exc:
+        print(str(exc), file=sys.stderr)
+        return 2
+    print(json.dumps(proposal, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
