+# ============================================================================
+# Nava form-filling assistant
+# ============================================================================
+# Open with:
+#   DASHBOARD_CONFIG=products/nava-form-filling.yaml streamlit run dashboard.py
+#
+# This product has no Phoenix project. The cold path has not been run against
+# a model. Do not point this file at a live Phoenix instance, and do not treat
+# the numbers below as production traffic.
+# ============================================================================
+
+product:
+  name: "Nava form-filling assistant"
+
+# ---------------------------------------------------------------------------
+# Cost assumptions. A reviewer can change these in the Form-fill cost view.
+# price_per_model_turn and turns_per_cold_run are placeholders so the formula
+# has numbers. They are not a quote and not a trace export.
+#
+# scribe_closes / scribe_share_denominator defaults to 5/9 because that is
+# what the local drift lab scored on its fixture set. It is not a production
+# rate. The named "Drift lab fixture set (5 of 9)" row stays 5 of 9 even if
+# this share is edited.
+# ---------------------------------------------------------------------------
+form_fill_cost:
+  currency: USD
+  price_per_model_turn: 0.05
+  turns_per_cold_run: 10
+  scribe_closes: 5
+  scribe_share_denominator: 9
diff --git a/tests/test_form_fill_cost.py b/tests/test_form_fill_cost.py
