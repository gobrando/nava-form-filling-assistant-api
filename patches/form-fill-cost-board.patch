diff --git a/form_fill_cost.py b/form_fill_cost.py
new file mode 100644
index 0000000..6ace5ff
--- /dev/null
+++ b/form_fill_cost.py
@@ -0,0 +1,497 @@
+"""
+Form-fill cost scenarios for a product that has not been run against a model.
+
+The warm path (`executionMode: script`) is a playbook join and makes no model
+calls. A cold path is one Eve run (scout, fill, form review, scribe). The
+deterministic scribe keeps a drifted page on the warm path when every old
+field still has one unambiguous label. A tie, a protected-field mismatch, or
+a dropped field refuses, and the model is only for that refusal.
+
+Nothing in this module reads Phoenix or invents a traffic volume. A scenario
+scale is labeled as a scenario. The 5-of-9 row is the local drift lab's
+fixture set, not a production rate.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from decimal import Decimal
+from fractions import Fraction
+from typing import List, Optional
+
+# The local drift lab scored 5 publishable fixtures out of 9.
+# That is a fixture set. It is not a production rate.
+DRIFT_LAB_CLOSES = 5
+DRIFT_LAB_FIXTURES = 9
+DRIFT_LAB_SCENARIO_NAME = "Drift lab fixture set (5 of 9)"
+ALL_MODEL_SCENARIO_NAME = "All drifts sent to the model"
+
+# Comparison rows use the fixture count so 5 of 9 stays a whole number.
+# This is not a county volume.
+SCENARIO_SCALE = DRIFT_LAB_FIXTURES
+
+FORMULA = (
+    "warm_cost = 0\n"
+    "cold_cost = turns_per_cold_run * price_per_model_turn\n"
+    "cost_per_drift = (1 - scribe_close_share) * turns_per_cold_run * price_per_model_turn\n"
+    "scenario_cost = cost_per_drift * scenario_drifts"
+)
+
+# Shown with the formula so a reviewer can see what the cost does not include.
+FORMULA_EXCLUSIONS = (
+    "Readback is still required and is not a model turn. "
+    "The product never submits; a human does. Submission is not a model turn."
+)
+
+DRIFT_SCOPE_NOTE = (
+    "These scenarios are drifted pages that already have a playbook. "
+    "A site with no playbook is a cold run, and the scribe close share does not apply to it."
+)
+
+
+class CostAssumptionError(ValueError):
+    """An assumption is outside the range the formula allows."""
+
+
+@dataclass(frozen=True)
+class CostAssumptions:
+    """Explicit assumptions. None of these fields are measurements."""
+
+    price_per_model_turn: Decimal
+    turns_per_cold_run: int
+    scribe_closes: int
+    scribe_share_denominator: int
+    currency: str = "USD"
+
+    def validate(self) -> None:
+        if self.price_per_model_turn < 0:
+            raise CostAssumptionError("price_per_model_turn must be >= 0")
+        if not isinstance(self.turns_per_cold_run, int) or isinstance(self.turns_per_cold_run, bool):
+            raise CostAssumptionError("turns_per_cold_run must be a non-negative integer")
+        if self.turns_per_cold_run < 0:
+            raise CostAssumptionError("turns_per_cold_run must be >= 0")
+        if (
+            not isinstance(self.scribe_share_denominator, int)
+            or isinstance(self.scribe_share_denominator, bool)
+            or self.scribe_share_denominator <= 0
+        ):
+            raise CostAssumptionError("scribe_share_denominator must be a positive integer")
+        if (
+            not isinstance(self.scribe_closes, int)
+            or isinstance(self.scribe_closes, bool)
+            or self.scribe_closes < 0
+            or self.scribe_closes > self.scribe_share_denominator
+        ):
+            raise CostAssumptionError(
+                "scribe_closes must be an integer from 0 through scribe_share_denominator"
+            )
+        if not self.currency:
+            raise CostAssumptionError("currency must be set")
+
+    @property
+    def scribe_close_share(self) -> Fraction:
+        self.validate()
+        return Fraction(self.scribe_closes, self.scribe_share_denominator)
+
+
+def _as_decimal(value) -> Decimal:
+    if isinstance(value, Decimal):
+        return value
+    if isinstance(value, float):
+        return Decimal(format(value, ".10f"))
+    return Decimal(str(value))
+
+
+def _fraction_to_decimal(value: Fraction) -> Decimal:
+    return Decimal(value.numerator) / Decimal(value.denominator)
+
+
+def assumptions_from_config(config) -> CostAssumptions:
+    """Build assumptions from a FormFillCostConfig (or any object with the fields)."""
+    built = CostAssumptions(
+        price_per_model_turn=_as_decimal(config.price_per_model_turn),
+        turns_per_cold_run=int(config.turns_per_cold_run),
+        scribe_closes=int(config.scribe_closes),
+        scribe_share_denominator=int(config.scribe_share_denominator),
+        currency=str(config.currency or "USD"),
+    )
+    built.validate()
+    return built
+
+
+def warm_cost(_assumptions: Optional[CostAssumptions] = None) -> Decimal:
+    """A warm run is a playbook join. It does not call a model."""
+    return Decimal("0")
+
+
+def cold_cost(assumptions: CostAssumptions) -> Decimal:
+    """One cold run: Eve (scout, fill, form review, scribe)."""
+    assumptions.validate()
+    return assumptions.price_per_model_turn * Decimal(assumptions.turns_per_cold_run)
+
+
+def cost_for_execution_mode(execution_mode: str, assumptions: CostAssumptions) -> Decimal:
+    """Cost of one recorded run. `script` is warm. `model` is one cold run."""
+    if execution_mode == "script":
+        return warm_cost(assumptions)
+    if execution_mode == "model":
+        return cold_cost(assumptions)
+    raise CostAssumptionError(f"unknown executionMode: {execution_mode}")
+
+
+def drift_model_cost(publishable: bool, assumptions: CostAssumptions) -> Decimal:
+    """The model is only for a refusal. A publishable repair stays warm."""
+    if publishable:
+        return warm_cost(assumptions)
+    return cold_cost(assumptions)
+
+
+def cost_per_drift(assumptions: CostAssumptions, close_share: Optional[Fraction] = None) -> Decimal:
+    """
+    Expected model cost of one drift.
+
+    cost_per_drift = (1 - scribe_close_share) * turns_per_cold_run * price_per_model_turn
+    """
+    assumptions.validate()
+    share = assumptions.scribe_close_share if close_share is None else close_share
+    if share < 0 or share > 1:
+        raise CostAssumptionError("scribe_close_share must be between 0 and 1")
+    refused = Fraction(1) - share
+    return cold_cost(assumptions) * _fraction_to_decimal(refused)
+
+
+@dataclass(frozen=True)
+class ScenarioResult:
+    name: str
+    classification: str
+    note: str
+    close_share: Fraction
+    scenario_drifts: int
+    drifts_closed_without_model: Fraction
+    drifts_sent_to_model: Fraction
+    model_turns: Decimal
+    cost: Decimal
+    cost_per_drift: Decimal
+    currency: str
+
+    def as_record(self) -> dict:
+        return {
+            "scenario": self.name,
+            "classification": self.classification,
+            "close_share": _format_fraction(self.close_share),
+            "scenario_drifts": self.scenario_drifts,
+            "drifts_closed_without_model": _format_fraction(self.drifts_closed_without_model),
+            "drifts_sent_to_model": _format_fraction(self.drifts_sent_to_model),
+            "model_turns": _format_decimal(self.model_turns),
+            "cost": format_money(self.cost, self.currency),
+            "cost_per_drift": format_money(self.cost_per_drift, self.currency),
+            "note": self.note,
+        }
+
+
+def _format_fraction(value: Fraction) -> str:
+    whole = Fraction(value)
+    if whole.denominator == 1:
+        return str(whole.numerator)
+    return f"{whole.numerator}/{whole.denominator}"
+
+
+def _format_decimal(value: Decimal) -> str:
+    quantized = value.quantize(Decimal("0.0001"))
+    text = format(quantized, "f")
+    if "." in text:
+        text = text.rstrip("0").rstrip(".")
+    return text or "0"
+
+
+def format_money(amount: Decimal, currency: str) -> str:
+    quantized = amount.quantize(Decimal("0.0001"))
+    text = format(quantized, "f")
+    whole, frac = text.split(".")
+    frac = frac.rstrip("0")
+    if len(frac) < 2:
+        frac = frac.ljust(2, "0")
+    return f"{whole}.{frac} {currency}"
+
+
+def _scenario_result(
+    name: str,
+    note: str,
+    closes: int,
+    denominator: int,
+    scenario_drifts: int,
+    assumptions: CostAssumptions,
+) -> ScenarioResult:
+    share = Fraction(closes, denominator)
+    closed = Fraction(scenario_drifts) * share
+    sent = Fraction(scenario_drifts) - closed
+    per_drift = cost_per_drift(assumptions, share)
+    turns = Decimal(assumptions.turns_per_cold_run) * _fraction_to_decimal(sent)
+    cost = assumptions.price_per_model_turn * turns
+    return ScenarioResult(
+        name=name,
+        classification="scenario",
+        note=note,
+        close_share=share,
+        scenario_drifts=scenario_drifts,
+        drifts_closed_without_model=closed,
+        drifts_sent_to_model=sent,
+        model_turns=turns,
+        cost=cost,
+        cost_per_drift=per_drift,
+        currency=assumptions.currency,
+    )
+
+
+def scenario_table(
+    assumptions: CostAssumptions,
+    scenario_drifts: int = SCENARIO_SCALE,
+) -> List[ScenarioResult]:
+    """
+    Compare two named scenarios, plus the reviewer's current assumption.
+
+    The scale defaults to the drift lab fixture count so the 5-of-9 row is
+    an integer count of fixtures. It is a scenario scale, not a measured volume.
+    """
+    assumptions.validate()
+    if not isinstance(scenario_drifts, int) or isinstance(scenario_drifts, bool) or scenario_drifts < 0:
+        raise CostAssumptionError("scenario_drifts must be a non-negative integer")
+
+    rows = [
+        _scenario_result(
+            ALL_MODEL_SCENARIO_NAME,
+            "Scenario: every drift is sent to the model. Not a measurement of traffic.",
+            0,
+            1,
+            scenario_drifts,
+            assumptions,
+        ),
+        _scenario_result(
+            DRIFT_LAB_SCENARIO_NAME,
+            (
+                "Scenario: the local drift lab fixture set, 5 of 9 fixtures publish. "
+                "Not a production rate. The model path has not been run."
+            ),
+            DRIFT_LAB_CLOSES,
+            DRIFT_LAB_FIXTURES,
+            scenario_drifts,
+            assumptions,
+        ),
+        _scenario_result(
+            "Current assumption",
+            (
+                "Scenario: the close share set in the assumptions above. "
+                "Not a measurement. The scale is the drift lab fixture count, "
+                "so this row can be compared with the other two. It is not a county volume."
+            ),
+            assumptions.scribe_closes,
+            assumptions.scribe_share_denominator,
+            scenario_drifts,
+            assumptions,
+        ),
+    ]
+    for row in rows:
+        if row.classification != "scenario":
+            raise CostAssumptionError("every cost row must be labeled as a scenario")
+    return rows
+
+
+def substituted_formula(assumptions: CostAssumptions) -> str:
+    """The formula with the current assumptions filled in."""
+    assumptions.validate()
+    share = assumptions.scribe_close_share
+    cold = cold_cost(assumptions)
+    per_drift = cost_per_drift(assumptions)
+    price = format_money(assumptions.price_per_model_turn, assumptions.currency)
+    return (
+        f"{FORMULA}\n"
+        f"\n"
+        f"price_per_model_turn = {price} (assumption)\n"
+        f"turns_per_cold_run = {assumptions.turns_per_cold_run} (assumption; cold path has not been run)\n"
+        f"scribe_close_share = {share.numerator}/{share.denominator} (assumption)\n"
+        f"warm_cost = {format_money(warm_cost(assumptions), assumptions.currency)}\n"
+        f"cold_cost = {assumptions.turns_per_cold_run} * {price}\n"
+        f"          = {format_money(cold, assumptions.currency)}\n"
+        f"cost_per_drift = (1 - {share.numerator}/{share.denominator}) * {assumptions.turns_per_cold_run} * {price}\n"
+        f"               = {format_money(per_drift, assumptions.currency)}\n"
+        f"\n"
+        f"{FORMULA_EXCLUSIONS}"
+    )
+
+
+REPAIR_RULES = (
+    {
+        "case": "Every old field still has one unambiguous label",
+        "model": "No model calls",
+        "next_run": "Stays warm (executionMode script). A playbook join fills the form.",
+    },
+    {
+        "case": "Tie — two controls share one label",
+        "model": "Model, only because the deterministic scribe refused",
+        "next_run": "Cold path until a playbook can be published.",
+    },
+    {
+        "case": "Protected-field mismatch — SSN onto case number",
+        "model": "Model, only because the deterministic scribe refused",
+        "next_run": "Cold path. The scribe will not move SSN onto case number.",
+    },
+    {
+        "case": "Dropped field",
+        "model": "Model, only because the deterministic scribe refused",
+        "next_run": "Cold path. One unresolved field blocks publish.",
+    },
+    {
+        "case": "Readback",
+        "model": "Not a model turn",
+        "next_run": "Still required. A repaired playbook does not skip readback.",
+    },
+    {
+        "case": "Submit",
+        "model": "Not a model turn",
+        "next_run": "The product never submits. A human does.",
+    },
+)
+
+
+def render_form_fill_cost(config, product_name: str = "Nava form-filling assistant") -> None:
+    """Streamlit view. Assumptions are editable; the math is form_fill_cost."""
+    import streamlit as st
+
+    st.header("Form-fill cost")
+    st.markdown(f"*{product_name}*")
+    st.info(
+        "The cold path (Eve: scout, fill, form review, scribe) has not been run "
+        "against a model. This view does not connect to Phoenix and it does not "
+        "show production traffic. Every cost below is a scenario computed from "
+        "the assumptions. Change the assumptions to recompute. Do not read the "
+        "scenario scale as a county volume."
+    )
+
+    st.subheader("Assumptions")
+    st.caption(
+        "These start from the product config. Editing them here does not write "
+        "the file. The cold-path turn count and the price are assumptions, "
+        "because that path has never been run."
+    )
+    col_price, col_turns, col_closes, col_denom = st.columns(4)
+    with col_price:
+        price = st.number_input(
+            f"Price per model turn ({config.currency})",
+            min_value=0.0,
+            value=float(config.price_per_model_turn),
+            step=0.01,
+            format="%.4f",
+            key="form_fill_price_per_model_turn",
+            help="Assumption. Not a measured price. The cold path has not been run against a model.",
+        )
+    with col_turns:
+        turns = st.number_input(
+            "Turns per cold run",
+            min_value=0,
+            value=int(config.turns_per_cold_run),
+            step=1,
+            key="form_fill_turns_per_cold_run",
+            help=(
+                "Assumption. A cold run is Eve: scout, fill, form review, and scribe. "
+                "The turn count has not been measured."
+            ),
+        )
+    with col_denom:
+        denominator = st.number_input(
+            "Drifts in the close share",
+            min_value=1,
+            value=int(config.scribe_share_denominator),
+            step=1,
+            key="form_fill_scribe_share_denominator",
+            help=(
+                "Denominator of the assumption share. This is a ratio, not a count "
+                "of applications. The default 9 is the drift lab fixture count."
+            ),
+        )
+    with col_closes:
+        closes = st.number_input(
+            "Drifts the deterministic scribe closes",
+            min_value=0,
+            value=int(config.scribe_closes),
+            step=1,
+            key="form_fill_scribe_closes",
+            help=(
+                "Numerator of the assumption share. The default 5 of 9 is the local "
+                "drift lab fixture set, not a production rate."
+            ),
+        )
+
+    try:
+        assumptions = CostAssumptions(
+            price_per_model_turn=_as_decimal(price),
+            turns_per_cold_run=int(turns),
+            scribe_closes=int(closes),
+            scribe_share_denominator=int(denominator),
+            currency=str(config.currency or "USD"),
+        )
+        assumptions.validate()
+    except (CostAssumptionError, ValueError) as exc:
+        st.error(str(exc))
+        return
+
+    st.subheader("Formula")
+    st.code(substituted_formula(assumptions), language="text")
+
+    warm = warm_cost(assumptions)
+    cold = cold_cost(assumptions)
+    per_drift = cost_per_drift(assumptions)
+    metric_warm, metric_cold, metric_drift = st.columns(3)
+    with metric_warm:
+        st.metric(
+            "Warm path",
+            format_money(warm, assumptions.currency),
+            help="executionMode script. A playbook join. No model calls.",
+        )
+    with metric_cold:
+        st.metric(
+            "One cold run",
+            format_money(cold, assumptions.currency),
+            help="executionMode model. Eve: scout, fill, form review, scribe. Assumption, not a measured run.",
+        )
+    with metric_drift:
+        st.metric(
+            "Expected cost per drift",
+            format_money(per_drift, assumptions.currency),
+            help="Uses the close share in the assumptions. A scenario, not a measured rate.",
+        )
+
+    st.subheader("Scenario table")
+    st.caption(
+        f"Each row is a scenario on a scale of {SCENARIO_SCALE} drifts. "
+        f"{SCENARIO_SCALE} is the local drift lab's fixture count, so the "
+        "5-of-9 row counts fixtures. It is not a county volume and not a "
+        f"production rate. {DRIFT_SCOPE_NOTE}"
+    )
+    rows = scenario_table(assumptions)
+    st.dataframe(
+        [row.as_record() for row in rows],
+        hide_index=True,
+        use_container_width=True,
+    )
+
+    lab = rows[1]
+    all_model = rows[0]
+    difference = all_model.cost - lab.cost
+    st.caption(
+        f"On that scenario scale, sending every drift to the model costs "
+        f"{format_money(all_model.cost, assumptions.currency)}. "
+        f"The drift lab fixture set sends "
+        f"{_format_fraction(lab.drifts_sent_to_model)} of "
+        f"{SCENARIO_SCALE} to the model and costs "
+        f"{format_money(lab.cost, assumptions.currency)}. "
+        f"The difference, {format_money(difference, assumptions.currency)}, "
+        "is the model cost those published fixtures do not spend in this scenario."
+    )
+
+    st.subheader("What the deterministic scribe closes")
+    st.markdown(
+        "When every old field still has one unambiguous label, the scribe "
+        "publishes and the next run stays warm. A tie, a protected-field "
+        "mismatch (SSN onto case number), or a dropped field refuses. "
+        "The model is only for the refusal."
+    )
+    st.dataframe(list(REPAIR_RULES), hide_index=True, use_container_width=True)
