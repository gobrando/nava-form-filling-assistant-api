--- /dev/null
+++ b/tests/test_form_fill_cost.py
@@ -0,0 +1,208 @@
+"""Cost math for the Nava form-filling assistant. No Phoenix, no traffic."""
+import unittest
+from decimal import Decimal
+from fractions import Fraction
+from pathlib import Path
+
+from config import load_config
+from form_fill_cost import (
+    ALL_MODEL_SCENARIO_NAME,
+    DRIFT_LAB_CLOSES,
+    DRIFT_LAB_FIXTURES,
+    DRIFT_LAB_SCENARIO_NAME,
+    DRIFT_SCOPE_NOTE,
+    FORMULA,
+    SCENARIO_SCALE,
+    substituted_formula,
+    CostAssumptionError,
+    CostAssumptions,
+    cold_cost,
+    cost_for_execution_mode,
+    cost_per_drift,
+    drift_model_cost,
+    scenario_table,
+    warm_cost,
+)
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def assumptions(**overrides) -> CostAssumptions:
+    values = dict(
+        price_per_model_turn=Decimal("0.05"),
+        turns_per_cold_run=10,
+        scribe_closes=5,
+        scribe_share_denominator=9,
+        currency="USD",
+    )
+    values.update(overrides)
+    built = CostAssumptions(**values)
+    built.validate()
+    return built
+
+
+class WarmAndColdTests(unittest.TestCase):
+    def test_warm_path_has_no_model_cost(self):
+        self.assertEqual(warm_cost(assumptions()), Decimal("0"))
+        self.assertEqual(cost_for_execution_mode("script", assumptions()), Decimal("0"))
+
+    def test_cold_path_is_turns_times_price(self):
+        cost = cold_cost(assumptions())
+        self.assertEqual(cost, Decimal("0.50"))
+        self.assertEqual(cost_for_execution_mode("model", assumptions()), cost)
+
+    def test_unknown_execution_mode_is_rejected(self):
+        with self.assertRaises(CostAssumptionError):
+            cost_for_execution_mode("submit", assumptions())
+
+    def test_formula_names_the_three_assumptions(self):
+        self.assertIn("price_per_model_turn", FORMULA)
+        self.assertIn("turns_per_cold_run", FORMULA)
+        self.assertIn("scribe_close_share", FORMULA)
+        self.assertIn("warm_cost = 0", FORMULA)
+        self.assertNotIn("county", FORMULA.lower())
+
+    def test_substituted_formula_uses_the_assumptions(self):
+        text = substituted_formula(assumptions())
+        self.assertIn("scribe_close_share = 5/9", text)
+        self.assertIn("cold_cost = 10 * 0.05 USD", text)
+        self.assertIn("= 0.50 USD", text)
+        self.assertIn("= 0.2222 USD", text)
+        self.assertIn("Readback is still required", text)
+        self.assertIn("never submits", text)
+        self.assertNotIn("000000", text)
+
+
+class DriftRepairTests(unittest.TestCase):
+    def test_publishable_repair_stays_warm(self):
+        self.assertEqual(drift_model_cost(True, assumptions()), Decimal("0"))
+
+    def test_refusal_costs_one_cold_run(self):
+        self.assertEqual(drift_model_cost(False, assumptions()), Decimal("0.50"))
+
+    def test_expected_cost_uses_the_unclosed_share(self):
+        # 5 of 9 close, so 4 of 9 are refusals. Each refusal is one cold run.
+        expected = Decimal("0.50") * Decimal(4) / Decimal(9)
+        self.assertEqual(cost_per_drift(assumptions()), expected)
+
+    def test_closing_every_drift_removes_the_model_cost(self):
+        closed = assumptions(scribe_closes=9, scribe_share_denominator=9)
+        self.assertEqual(cost_per_drift(closed), Decimal("0"))
+
+    def test_sending_every_drift_to_the_model_is_one_cold_run_each(self):
+        none_closed = assumptions(scribe_closes=0, scribe_share_denominator=9)
+        self.assertEqual(cost_per_drift(none_closed), Decimal("0.50"))
+
+    def test_more_closes_never_increases_cost(self):
+        previous = None
+        for closes in range(0, 10):
+            cost = cost_per_drift(assumptions(scribe_closes=closes))
+            if previous is not None:
+                self.assertLessEqual(cost, previous)
+            previous = cost
+
+
+class ScenarioTableTests(unittest.TestCase):
+    def test_named_rows_and_the_lab_fixture_arithmetic(self):
+        rows = scenario_table(assumptions())
+        self.assertEqual(
+            [row.name for row in rows],
+            [
+                ALL_MODEL_SCENARIO_NAME,
+                DRIFT_LAB_SCENARIO_NAME,
+                "Current assumption",
+            ],
+        )
+        for row in rows:
+            self.assertEqual(row.classification, "scenario")
+            self.assertEqual(row.scenario_drifts, SCENARIO_SCALE)
+            self.assertIn("not a", row.note.lower())
+
+        all_model, lab, current = rows
+        self.assertEqual(all_model.drifts_closed_without_model, Fraction(0))
+        self.assertEqual(all_model.drifts_sent_to_model, Fraction(9))
+        self.assertEqual(all_model.model_turns, Decimal("90"))
+        self.assertEqual(all_model.cost, Decimal("4.50"))
+
+        self.assertEqual(lab.close_share, Fraction(DRIFT_LAB_CLOSES, DRIFT_LAB_FIXTURES))
+        self.assertEqual(lab.drifts_closed_without_model, Fraction(5))
+        self.assertEqual(lab.drifts_sent_to_model, Fraction(4))
+        self.assertEqual(lab.model_turns, Decimal("40"))
+        self.assertEqual(lab.cost, Decimal("2.00"))
+        self.assertIn("fixture", lab.note.lower())
+        self.assertIn("not a production rate", lab.note.lower())
+        self.assertNotIn("county", lab.note.lower())
+        self.assertIn("no playbook", DRIFT_SCOPE_NOTE.lower())
+        self.assertIn("cold run", DRIFT_SCOPE_NOTE.lower())
+
+        # The product default matches the lab, so the assumption row agrees.
+        self.assertEqual(current.cost, lab.cost)
+        self.assertEqual(current.drifts_sent_to_model, Fraction(4))
+
+    def test_editing_the_share_does_not_rewrite_the_lab_row(self):
+        rows = scenario_table(assumptions(scribe_closes=1, scribe_share_denominator=2))
+        all_model, lab, current = rows
+        self.assertEqual(lab.drifts_closed_without_model, Fraction(5))
+        self.assertEqual(lab.cost, Decimal("2.00"))
+        self.assertEqual(all_model.cost, Decimal("4.50"))
+        # Half of 9 fixtures, as a scenario: 4.5 closed, 4.5 sent to the model.
+        self.assertEqual(current.close_share, Fraction(1, 2))
+        self.assertEqual(current.drifts_closed_without_model, Fraction(9, 2))
+        self.assertEqual(current.drifts_sent_to_model, Fraction(9, 2))
+        self.assertEqual(current.model_turns, Decimal("45"))
+        self.assertEqual(current.cost, Decimal("2.25"))
+
+    def test_zero_price_and_zero_turns_are_zero_cost_scenarios(self):
+        rows = scenario_table(assumptions(price_per_model_turn=Decimal("0"), turns_per_cold_run=0))
+        for row in rows:
+            self.assertEqual(row.cost, Decimal("0"))
+            self.assertEqual(row.classification, "scenario")
+
+    def test_invalid_share_is_rejected(self):
+        with self.assertRaises(CostAssumptionError):
+            assumptions(scribe_closes=10, scribe_share_denominator=9).validate()
+        with self.assertRaises(CostAssumptionError):
+            assumptions(scribe_closes=-1).validate()
+        with self.assertRaises(CostAssumptionError):
+            assumptions(price_per_model_turn=Decimal("-0.01")).validate()
+        with self.assertRaises(CostAssumptionError):
+            scenario_table(assumptions(), scenario_drifts=-1)
+
+
+class ProductConfigTests(unittest.TestCase):
+    def test_nava_product_file_is_assumptions_not_a_phoenix_source(self):
+        config = load_config(str(ROOT / "products" / "nava-form-filling.yaml"))
+        self.assertEqual(config.product_name, "Nava form-filling assistant")
+        self.assertEqual(config.secondary_phoenix_url, "")
+        self.assertIsNotNone(config.form_fill_cost)
+        cost = config.form_fill_cost
+        self.assertEqual(cost.currency, "USD")
+        self.assertEqual(cost.price_per_model_turn, 0.05)
+        self.assertEqual(cost.turns_per_cold_run, 10)
+        self.assertEqual(cost.scribe_closes, DRIFT_LAB_CLOSES)
+        self.assertEqual(cost.scribe_share_denominator, DRIFT_LAB_FIXTURES)
+
+        loaded = assumptions(
+            price_per_model_turn=Decimal(str(cost.price_per_model_turn)),
+            turns_per_cold_run=cost.turns_per_cold_run,
+            scribe_closes=cost.scribe_closes,
+            scribe_share_denominator=cost.scribe_share_denominator,
+            currency=cost.currency,
+        )
+        rows = scenario_table(loaded)
+        self.assertEqual(rows[0].cost, Decimal("4.50"))
+        self.assertEqual(rows[1].cost, Decimal("2.00"))
+        self.assertEqual(rows[1].name, DRIFT_LAB_SCENARIO_NAME)
+
+    def test_example_config_has_no_form_fill_section(self):
+        config = load_config(str(ROOT / "config.example.yaml"))
+        self.assertIsNone(config.form_fill_cost)
+        self.assertEqual(config.product_name, "My AI Product")
+
+    def test_missing_config_keeps_defaults(self):
+        config = load_config(str(ROOT / "does-not-exist.yaml"))
+        self.assertIsNone(config.form_fill_cost)
+
+
+if __name__ == "__main__":
+    unittest.main()
