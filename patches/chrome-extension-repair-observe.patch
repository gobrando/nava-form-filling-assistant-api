index 0000000..924c7f0
--- /dev/null
+++ b/shared/repair-observe.js
@@ -0,0 +1,497 @@
+(function installRepairObserve(root) {
+  'use strict';
+
+  /**
+   * Reads the open page for a deterministic playbook repair.
+   *
+   * An observation is a selector, an accessible label, an input type, and how
+   * many elements that selector matches. It is not a field map. This module
+   * does not decide which old field moved where. The API does that, and only
+   * when the caseworker sends this description. Values, placeholders, and
+   * typed input are not read.
+   *
+   * Program slug: the caseworker already chooses a program in the side panel.
+   * Those ids are the API slugs. A BenefitsCal application can include
+   * CalFresh, Medi-Cal, and CalWORKs together; the repair call takes one slug,
+   * so the first selected id is sent and the API looks up the playbook that
+   * includes it. An empty selection is not guessed from the page address.
+   */
+
+  const MAX_OBSERVED = 80;
+  const MAX_COUNT = 50;
+  const MAX_SELECTOR = 500;
+  const MAX_LABEL = 240;
+  const MAX_QUESTION = 240;
+  const MAX_TYPE = 40;
+  const FALLBACK_PROGRAMS = ['calfresh', 'medical', 'wic', 'calworks', 'ihss'];
+  const STOP = new Set([
+    'the', 'and', 'for', 'with', 'your', 'you', 'what', 'this', 'that', 'from',
+    'please', 'date', 'code', 'number',
+  ]);
+  const ALIASES = {
+    postalCode: 'zip postal',
+    dateOfBirth: 'birth dob birthday',
+    ssn: 'ssn social security',
+    ein: 'ein employer',
+    phone: 'phone telephone mobile',
+    email: 'email',
+    primaryLanguage: 'language',
+    fullName: 'full',
+    firstName: 'first',
+    lastName: 'last',
+    addressLine1: 'street',
+    income: 'income wages',
+    childcare: 'childcare daycare',
+    unemployment: 'unemployment',
+    preferredContact: 'contact',
+  };
+  const FALLBACK_LABELS = {
+    ssn: 'Social Security Number',
+    ein: 'Employer Identification Number',
+    dateOfBirth: 'Date of birth',
+    phone: 'Phone',
+    email: 'Email',
+    postalCode: 'ZIP code',
+    fullName: 'Full name',
+    firstName: 'First name',
+    lastName: 'Last name',
+  };
+
+  function cleanText(value) {
+    return String(value || '').replace(/\s+/g, ' ').trim();
+  }
+
+  function knownProgramIds() {
+    const programs = root.NavaProgramCatalog?.PROGRAMS;
+    if (Array.isArray(programs) && programs.length) {
+      return programs.map((program) => program.id).filter(Boolean);
+    }
+    return FALLBACK_PROGRAMS;
+  }
+
+  function repairProgramSlug(programIds) {
+    const known = new Set(knownProgramIds());
+    const selected = [];
+    (Array.isArray(programIds) ? programIds : []).forEach((id) => {
+      const slug = String(id || '').trim();
+      if (!slug || !known.has(slug) || selected.includes(slug)) return;
+      selected.push(slug);
+    });
+    return selected[0] || null;
+  }
+
+  function cssEscape(document, value) {
+    const escape = document?.defaultView?.CSS?.escape || root.CSS?.escape;
+    if (typeof escape === 'function') return escape(String(value));
+    return String(value).replace(/[^a-zA-Z0-9_-]/g, (character) => `\\${character}`);
+  }
+
+  function attrEscape(value) {
+    return String(value).replace(/\\/g, '\\\\').replace(/"/g, '\\"');
+  }
+
+  function ephemeralId(id) {
+    if (!id || id.length > 80) return true;
+    if (/^[0-9]+$/.test(id) || /\s/.test(id)) return true;
+    if (/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(id)) return true;
+    if (/^(?:ember\d|react-|vue-|ng-|ext-gen|:r\d)/i.test(id)) return true;
+    if (id.includes(':')) return true;
+    return false;
+  }
+
+  function isCollectable(element) {
+    const tag = element?.tagName;
+    if (tag !== 'INPUT' && tag !== 'SELECT' && tag !== 'TEXTAREA') return false;
+    if (tag !== 'INPUT') return true;
+    const type = cleanText(element.getAttribute('type') || 'text').toLowerCase();
+    return !['hidden', 'submit', 'button', 'reset', 'image', 'file'].includes(type);
+  }
+
+  function directText(element) {
+    let text = '';
+    element.childNodes.forEach((node) => {
+      if (node.nodeType === 3) {
+        text += ` ${node.nodeValue || ''}`;
+        return;
+      }
+      if (node.nodeType !== 1) return;
+      const tag = node.tagName;
+      if (['INPUT', 'SELECT', 'TEXTAREA', 'BUTTON', 'SCRIPT', 'STYLE'].includes(tag)) return;
+      text += ` ${directText(node)}`;
+    });
+    return cleanText(text);
+  }
+
+  function accessibleLabel(element) {
+    const document = element.ownerDocument;
+    const id = element.getAttribute('id');
+    if (id && document?.querySelectorAll) {
+      const labels = [...document.querySelectorAll('label')].filter((label) => label.getAttribute('for') === id);
+      const text = cleanText(labels.map((label) => directText(label)).join(' '));
+      if (text) return text.slice(0, MAX_LABEL);
+    }
+    const wrapped = element.closest?.('label');
+    if (wrapped) {
+      const text = directText(wrapped);
+      if (text) return text.slice(0, MAX_LABEL);
+    }
+    const aria = cleanText(element.getAttribute('aria-label'));
+    if (aria) return aria.slice(0, MAX_LABEL);
+    const labelledBy = cleanText(element.getAttribute('aria-labelledby'));
+    if (labelledBy && document?.getElementById) {
+      const text = cleanText(labelledBy.split(/\s+/).map((ref) => {
+        const node = document.getElementById(ref);
+        if (!node || node === element) return '';
+        if (['INPUT', 'SELECT', 'TEXTAREA'].includes(node.tagName)) return '';
+        return directText(node);
+      }).join(' '));
+      if (text) return text.slice(0, MAX_LABEL);
+    }
+    return '';
+  }
+
+  function questionFor(element, label) {
+    const group = element.closest?.('fieldset');
+    const legend = group?.querySelector?.('legend');
+    const text = legend ? directText(legend) : '';
+    if (!text || text === label) return '';
+    return text.slice(0, MAX_QUESTION);
+  }
+
+  function controlType(element) {
+    if (element.tagName === 'SELECT') return 'select';
+    if (element.tagName === 'TEXTAREA') return 'textarea';
+    return cleanText(element.getAttribute('type') || 'text').toLowerCase().slice(0, MAX_TYPE) || 'text';
+  }
+
+  function isRequired(element) {
+    return element.hasAttribute('required') || element.getAttribute('aria-required') === 'true';
+  }
+
+  function structuralSelector(element) {
+    const document = element.ownerDocument;
+    const parts = [];
+    let node = element;
+    while (node && node.nodeType === 1 && node !== document.documentElement) {
+      const id = node.getAttribute('id');
+      if (node !== element && id && !ephemeralId(id)) {
+        parts.unshift(`#${cssEscape(document, id)}`);
+        break;
+      }
