+    }
+  }
+
+  async function publishObservedRepair(uiToken) {
+    const current = state.repair;
+    if (!current?.confirming || !current.presented?.publishable) {
+      throw new Error('Review a dry run that can be published before saving it.');
+    }
+    if (current.publishing || current.published) return;
+    if (!repairObserve?.buildRepairRequest) {
+      throw new Error('The repair tools did not load. Nothing was published.');
+    }
+    const gateway = await agentPlanner.gatewayConfig();
+    if (!gateway?.endpoint || !gateway.token) {
+      throw new Error('Save the shared planner API address and a tenant key first. Nothing was published.');
+    }
+    current.publishing = true;
+    try {
+      const body = repairObserve.buildRepairRequest(current.observed, true);
+      setBusy('Publishing this repair for your organization. The form is not sent.');
+      const result = await postRepair(gateway, current.slug, body);
+      assertUiGeneration(uiToken);
+      if (state.repair !== current) return;
+      current.proposal = result.proposal;
+      current.presented = repairObserve.presentRepair(result.proposal, current.observed, engine.LABELS);
+      current.confirming = false;
+      current.published = true;
+      current.alreadyCurrent = result.alreadyCurrent;
+      current.unreachable = false;
+      current.problem = false;
+      current.statusNote = result.alreadyCurrent
+        ? 'This repair was already the current version for your organization. Nothing new was written. The shared playbook was left as it was. The form was not sent.'
+        : 'Saved a new version for your organization. The shared playbook was left as it was. The form was not sent.';
+      state.view = 'repair';
+    } catch (error) {
+      if (state.repair === current) {
+        current.publishing = false;
+        current.confirming = false;
+        current.problem = true;
+        current.unreachable = error.unreachable === true;
+        current.statusNote = error.unreachable
+          ? 'The repair service could not be reached, so nothing was published. Nothing was guessed from this page.'
+          : (error.message || 'The repair service could not be reached, so nothing was published.');
+        state.view = 'repair';
+      }
+    } finally {
+      if (state.repair === current) current.publishing = false;
+    }
+  }
+
