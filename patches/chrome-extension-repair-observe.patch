diff --git a/tests/repair-observe.test.cjs b/tests/repair-observe.test.cjs
new file mode 100644
index 0000000..6f5b507
--- /dev/null
+++ b/tests/repair-observe.test.cjs
@@ -0,0 +1,269 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { JSDOM } = require('jsdom');
+
+require('../shared/program-catalog.js');
+const repair = require('../shared/repair-observe.js');
+
+const root = path.resolve(__dirname, '..');
+const fixturePath = path.join(__dirname, 'fixtures', 'repair-observation.html');
+const html = fs.readFileSync(fixturePath, 'utf8');
+const LABELS = {
+  ssn: 'Social Security Number',
+  dateOfBirth: 'Date of birth',
+  phone: 'Phone',
+  email: 'Email',
+};
+
+const SECRET_TEXT = [
+  'Jordan Sample',
+  '123-45-6789',
+  '987-65-4321',
+  '951-555-1212',
+  '951-555-3434',
+  'SAMPLE-PLACEHOLDER',
+  'Typed Nickname',
+  'secret-clinic-value',
+  'SECRET-OPTION',
+  'hidden-secret-token',
+  'Should Not Travel',
+  '92501',
+  '92502',
+  'email-secret',
+  'WILDOMAR-TYPED',
+];
+
+function documentFromFixture() {
+  const document = new JSDOM(html).window.document;
+  for (const element of document.querySelectorAll('input, select, textarea')) {
+    const original = element.getAttribute.bind(element);
+    element.getAttribute = (name) => {
+      const key = String(name || '').toLowerCase();
+      if (key === 'value' || key === 'placeholder') throw new Error(`read ${key}`);
+      return original(name);
+    };
+    Object.defineProperty(element, 'value', {
+      configurable: true,
+      get() {
+        throw new Error('read value');
+      },
+    });
+    Object.defineProperty(element, 'placeholder', {
+      configurable: true,
+      get() {
+        throw new Error('read placeholder');
+      },
+    });
+  }
+  return document;
+}
+
+test('the fixture is filled in, and the observation still has no values', () => {
+  for (const secret of SECRET_TEXT) assert.match(html, new RegExp(secret.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')));
+  const collected = repair.collectObservations(documentFromFixture());
+  assert.equal(collected.refused, null);
+  const body = repair.buildRepairRequest(collected.observed, false);
+  const serialized = JSON.stringify(body);
+  for (const secret of SECRET_TEXT) assert.equal(serialized.includes(secret), false, secret);
+  assert.equal(/"value"\s*:/.test(serialized), false);
+  assert.equal(body.publish, false);
+  assert.deepEqual(body.observed, [
+    { selector: '#applicant-name', label: 'Name', type: 'text', count: 1, required: true },
+    { selector: '#ssn-a', label: 'Social Security Number', type: 'text', count: 1 },
+    { selector: '#ssn-b', label: 'Social Security Number', type: 'password', count: 1 },
+    { selector: 'input[name="phone"]:not([type="hidden"])', label: 'Phone', type: 'tel', count: 2 },
+    { selector: '#nickname', label: '', type: 'text', count: 1 },
+    { selector: '#clinic', label: 'WIC clinic', type: 'select', count: 1 },
+    { selector: 'input[name="legal-name"]:not([type="hidden"])', label: 'Legal name', type: 'text', count: 1 },
+    { selector: '#dup', label: 'ZIP code', type: 'text', count: 2 },
+    {
+      selector: '#contact-email',
+      label: 'Email',
+      type: 'radio',
+      count: 1,
+      question: 'Preferred contact method',
+    },
+    { selector: '#city-row > label > input', label: 'City', type: 'text', count: 1 },
+  ]);
+  for (const control of body.observed) {
+    assert.deepEqual(Object.keys(control).filter((key) => !['selector', 'label', 'type', 'count', 'question', 'required'].includes(key)), []);
+  }
+});
+
+test('a duplicate label is reported and not turned into a local mapping', () => {
+  const collected = repair.collectObservations(documentFromFixture());
+  const labels = collected.observed.filter((control) => control.label === 'Social Security Number');
+  assert.deepEqual(labels.map((control) => control.selector), ['#ssn-a', '#ssn-b']);
+  assert.deepEqual(labels.map((control) => control.count), [1, 1]);
+  const phones = collected.observed.find((control) => control.label === 'Phone');
+  assert.equal(phones.count, 2);
+  assert.equal(repair.proposeRepair, undefined);
+  assert.equal(repair.fieldMap, undefined);
+  assert.equal(Object.hasOwn(collected, 'fieldMap'), false);
+  const body = repair.buildRepairRequest(collected.observed, false);
+  assert.equal(Object.hasOwn(body, 'fieldMap'), false);
+  assert.equal(body.publish, false);
+});
+
+test('a repair request drops a value and publishes only on an explicit boolean', () => {
+  const dryRun = repair.buildRepairRequest([
+    {
+      selector: '#applicant-name',
+      label: 'Name',
+      type: 'text',
+      count: 1,
+      value: 'Jordan Sample',
+      question: '',
+      required: false,
+      extra: true,
+    },
+  ], false);
+  assert.deepEqual(dryRun, {
+    observed: [{ selector: '#applicant-name', label: 'Name', type: 'text', count: 1 }],
+    publish: false,
+  });
+  assert.equal(JSON.stringify(dryRun).includes('Jordan'), false);
+  assert.equal(repair.buildRepairRequest(dryRun.observed, 'true').publish, false);
+  assert.equal(repair.buildRepairRequest(dryRun.observed, true).publish, true);
+});
+
+test('the program slug comes from the caseworker selection', () => {
+  assert.equal(repair.repairProgramSlug(['wic']), 'wic');
+  assert.equal(repair.repairProgramSlug(['calfresh', 'medical', 'calworks']), 'calfresh');
+  assert.equal(repair.repairProgramSlug(['not-a-program', 'ihss']), 'ihss');
+  assert.equal(repair.repairProgramSlug([]), null);
+  assert.equal(repair.repairProgramSlug(undefined), null);
+});
+
+test('sentences describe the service result and do not invent a map', () => {
+  const observed = [
+    { selector: '#case-number', label: 'Case number', type: 'text', count: 1 },
+  ];
+  const proposal = repair.readRepairProposal({
+    publishable: false,
+    refused: 'Refused to guess ssn.',
+    kept: [],
+    moved: [],
+    unresolved: [{
+      purpose: 'ssn',
+      fromSelector: '#ssn',
+      toSelector: null,
+      disposition: 'unresolved',
+      reason: 'No unique label match for ssn.',
+      value: '123-45-6789',
+    }],
+    unmapped: [{ selector: '#case-number', label: 'Case number', reason: 'On the page, and not claimed.' }],
+    probes: [],
+    fieldMap: [{ fieldKey: '#case-number', purpose: 'ssn', value: '123-45-6789' }],
+  });
+  assert.equal(proposal.fieldMap, undefined);
+  assert.equal(JSON.stringify(proposal).includes('123-45-6789'), false);
+  const presented = repair.presentRepair(proposal, observed, LABELS);
+  assert.equal(presented.publishable, false);
+  assert.equal(presented.fieldMap, undefined);
+  assert.equal(presented.refused[0].kind, 'protected');
+  assert.match(presented.refused[0].sentence, /Case number/);
+  assert.match(presented.refused[0].sentence, /did not move onto/);
+  assert.equal(presented.unmapped[0].label, 'Case number');
+  assert.match(presented.publishNote, /cannot be published/);
+});
+
+test('a tie, a signature date, and a missing label stay unresolved in the wording', () => {
+  const tie = repair.presentRepair({
+    publishable: false,
+    refused: 'Refused to guess ssn.',
+    kept: [],
+    moved: [],
+    unresolved: [{ purpose: 'ssn', fromSelector: '#ssn', toSelector: null, reason: 'No unique label match for ssn.' }],
+    unmapped: [],
+    probes: [],
+  }, [
+    { selector: '#ssn-a', label: 'Social Security Number', type: 'text', count: 1 },
+    { selector: '#ssn-b', label: 'Social Security Number', type: 'text', count: 1 },
+  ], LABELS);
+  assert.equal(tie.refused[0].kind, 'tie');
+  assert.match(tie.refused[0].sentence, /will not guess/);
+
+  const signature = repair.presentRepair({
+    publishable: false,
+    refused: 'Refused to guess dateOfBirth.',
+    kept: [],
+    moved: [],
+    unresolved: [{ purpose: 'dateOfBirth', fromSelector: '#dob', toSelector: null, reason: 'No unique label match.' }],
+    unmapped: [],
+    probes: [],
+  }, [
+    { selector: '#signed-on', label: 'Signature date', type: 'date', count: 1 },
+  ], LABELS);
+  assert.equal(signature.refused[0].kind, 'protected');
+  assert.match(signature.refused[0].sentence, /signature date is not a date of birth/i);
+
+  const missing = repair.presentRepair({
+    publishable: false,
+    refused: '1 field(s) had no unique label match (phone).',
+    kept: [],
+    moved: [],
+    unresolved: [{ purpose: 'phone', fromSelector: '#phone', toSelector: null, reason: 'No unique label match for phone.' }],
+    unmapped: [{ selector: '#notes', label: '', reason: 'On the page.' }],
+    probes: [],
+  }, [
+    { selector: '#notes', label: '', type: 'text', count: 1 },
+  ], LABELS);
+  assert.equal(missing.refused[0].kind, 'missing');
+  assert.equal(missing.unmapped[0].label, 'No label');
+});
+
+test('kept and moved lines quote the selectors the service returned', () => {
+  const presented = repair.presentRepair({
+    publishable: true,
+    refused: null,
+    kept: [{ purpose: 'email', fromSelector: '#email', toSelector: '#email', reason: 'The previous selector still resolves to one control.' }],
+    moved: [{
+      purpose: 'phone',
+      fromSelector: '#old-phone',
+      toSelector: '#applicant-phone',
+      reason: 'The label "Phone" is the only control that still names this field.',
+    }],
+    unresolved: [],
+    unmapped: [],
+    probes: ['#email', '#applicant-phone'],
+  }, [
+    { selector: '#email', label: 'Email', type: 'email', count: 1 },
+    { selector: '#applicant-phone', label: 'Phone', type: 'tel', count: 1 },
+  ], LABELS);
+  assert.equal(presented.publishable, true);
+  assert.equal(presented.kept[0].selector, '#email');
+  assert.match(presented.kept[0].sentence, /still at #email/);
+  assert.deepEqual(presented.moved[0], {
+    label: 'Phone',
+    from: '#old-phone',
+    to: '#applicant-phone',
+    sentence: 'The label "Phone" is the only box that still names this field.',
+  });
+  assert.equal(presented.fieldMap, undefined);
+});
+
+test('the extension asks the page for an observation and does not map it locally', () => {
+  const agent = fs.readFileSync(path.join(root, 'content', 'form-agent.js'), 'utf8');
+  const panel = fs.readFileSync(path.join(root, 'sidepanel', 'sidepanel.js'), 'utf8');
+  const manifest = fs.readFileSync(path.join(root, 'manifest.json'), 'utf8');
+  assert.match(agent, /NAVA_OBSERVE_REPAIR/);
+  assert.match(agent, /collectObservations\(document\)/);
+  assert.match(agent, /buildRepairRequest\(collected\.observed, false\)/);
+  assert.doesNotMatch(agent, /proposeRepair/);
+  const background = fs.readFileSync(path.join(root, 'background.js'), 'utf8');
+  assert.match(background, /NAVA_OBSERVE_REPAIR/);
+  const writeCommands = background.slice(background.indexOf('WRITE_COMMAND_TYPES'), background.indexOf('ACTIVE_LEASE_MS'));
+  assert.doesNotMatch(writeCommands, /NAVA_OBSERVE_REPAIR/);
+  assert.match(manifest, /shared\/repair-observe\.js/);
+  assert.match(panel, /Dry-run a playbook repair/);
+  assert.match(panel, /Still in the same place/);
+  assert.match(panel, /buildRepairRequest\(response\.observed, false\)/);
+  assert.match(panel, /if \(!current\?\.confirming \|\| !current\.presented\?\.publishable\)/);
+  assert.match(panel, /buildRepairRequest\(current\.observed, true\)/);
+  assert.doesNotMatch(panel, /proposeRepair/);
+  const publish = panel.slice(panel.indexOf('async function publishObservedRepair'), panel.indexOf('async function onClick'));
+  assert.ok(publish.indexOf('if (!current?.confirming || !current.presented?.publishable)') < publish.indexOf('buildRepairRequest(current.observed, true)'));
+});
