+          set(loaded["routing"]) == set(loaded["categories"])
+          and all(mode == "scoped" for mode in loaded["routing"].values()),
+          str(loaded["routing"]))
+    rules = redact.build_rules(loaded)
+    for sample, rule in (
+        ("ssn 219-09-9999", "ssn_value"),
+        ("name: Jordan Sample", "person_name"),
+        ("income 42000", "income_amount"),
+        ("dob 03/14/1988", "date_of_birth"),
+    ):
+        found = {h["rule"] for h in redact.scan(sample, rules)}
+        check(f"form-filling redaction catches {rule}", rule in found, str(found))
+        check(f"the {rule} hit does not echo the value",
+              sample not in json.dumps(redact.scan(sample, rules)))
+    check("a count line with no household data is clean",
+          redact.is_clean("field counts: kept 12, moved 10, unresolved 11", rules))
+    check("a refusal reason that names the field, not its value, is clean",
+          redact.is_clean(
+              "refusal: ssn must not become case number; publish is all or nothing",
+              rules))
+
+    eve = extract.candidate_spans(
+        [{"kind": "text", "role": "assistant",
+          "text": "The cold path Eve would probably map the rest. I did not run a model."}],
+        loaded)
+    check("an unrun cold path is not a confirmed model run",
+          not any(s["verdict"] == "confirmed" for s in eve),
+          str([(s["statement"], s["verdict"]) for s in eve]))
+    stated = extract.candidate_spans(
+        [{"kind": "tool_result", "role": "user",
