+{
+  "name": "form-filling",
+  "description": "A form-filling agent run. The warm path is a script with no model. The cold path (Eve) is not a confirmed model run unless the transcript states one. Confirm execution mode when it is stated, the kept / moved / unresolved counts, the refusal reason, and whether a human submit was recorded. Values are never the observation. Publish is all or nothing. A human submits; the tool does not.",
+  "stall_cycles": 3,
+  "markers": {
+    "finalize": ["SCRIBE-FINALIZE", "\\bFINALIZE\\b"],
+    "report": [
+      "SCRIBE-REPORT",
+      "\\bSCRIBE-NOTE\\b",
+      "\\bLEARNED:",
+      "\\bCONFIRMED:",
+      "\\bexecution mode:",
+      "\\bfield counts:",
+      "\\brefusal:",
+      "\\bhuman_submit:"
+    ],
+    "stall": [
+      "SCRIBE-STALL",
+      "\\bwaiting for (?:the )?(?:human|operator|caseworker)\\b"
+    ]
+  },
+  "categories": {
+    "execution_mode": {
+      "means": "Record the execution mode the transcript states. script means the warm path ran with no model. model means a model run was shown. Do not record a mode the transcript does not state.",
+      "cues": [
+        "(?i)\\bexecution mode:\\s*script\\b",
+        "(?i)\\bexecution mode:\\s*model\\b",
+        "(?i)\\bwarm path:\\s*no model\\b"
+      ]
+    },
+    "field_counts": {
+      "means": "Record the kept, moved, and unresolved counts the transcript shows. The saved record is counts, never household values.",
+      "cues": [
+        "(?i)\\bfield counts:\\s*kept\\s+\\d+\\b",
+        "(?i)\\bkept\\s+\\d+\\b.{0,80}\\bmoved\\s+\\d+\\b.{0,80}\\bunresolved\\s+\\d+\\b"
+      ]
+    },
+    "refusal": {
+      "means": "Record the refusal reason the transcript shows: a label tie, a protected field on the wrong label, a dropped field, or publish refused. Do not record a guess the repair declined.",
+      "cues": [
+        "(?i)\\brefusal:\\s+\\S"
+      ]
+    },
+    "human_submit": {
+      "means": "Record whether a human submit was observed. Submission is human. An agent claim of submission is not a submit.",
+      "cues": [
+        "(?i)\\bhuman_submit:\\s*recorded\\b",
+        "(?i)\\bsubmission is human\\b",
+        "(?i)\\bsubmitted by (?:a )?human\\b"
+      ]
+    }
+  },
+  "routing": {
+    "execution_mode": "scoped",
+    "field_counts": "scoped",
+    "refusal": "scoped",
+    "human_submit": "scoped"
+  },
+  "promotion": {
+    "minimum_confirming_targets": 2
+  },
+  "redaction": {
+    "patterns": [
+      {"name": "ssn_value", "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b"},
+      {"name": "date_of_birth", "pattern": "\\b(?:0?[1-9]|1[0-2])[/-](?:0?[1-9]|[12]\\d|3[01])[/-](?:19|20)\\d{2}\\b"},
+      {"name": "income_amount", "pattern": "(?i)\\b(?:income|wages|salary|earnings)\\s*[:=]?\\s*\\$?\\d[\\d,]*(?:\\.\\d{2})?\\b"},
+      {"name": "person_name", "pattern": "(?i)\\bname\\s*[:=]\\s*[A-Za-z][A-Za-z'.-]+(?:\\s+[A-Za-z][A-Za-z'.-]+){1,3}\\b"}
+    ],
+    "disable": []
+  }
+}
