# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The app must connect as the least-privilege `nava_api` role. The table owner
# and superusers bypass row-level security, which is the tenant isolation.
POSTGRES_URL=postgresql://nava_api:password@127.0.0.1:5432/nava_form_filling
# The owner role, used only by `pnpm db:migrate`, `pnpm db:seed`, and `pnpm prove`.
POSTGRES_MIGRATION_URL=postgresql://postgres:password@127.0.0.1:5432/nava_form_filling

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------
# Pepper for hashing tenant API keys. Rotating it invalidates every key.
API_KEY_PEPPER=change-me-in-every-environment

# Comma-separated Chrome extension origins allowed to make credentialed
# requests to the connector endpoints.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://your-extension-id

ENVIRONMENT=dev

# ---------------------------------------------------------------------------
# Live connectors
# ---------------------------------------------------------------------------
# A Connection row's `secretRef` names a prefix, e.g. "env:APRICOT_ACME".
# The organization that owns the Apricot instance issues these credentials.
# APRICOT_ACME_BASE_URL=https://your-apricot-api-host
# APRICOT_ACME_CLIENT_ID=
# APRICOT_ACME_CLIENT_SECRET=
# APRICOT_ACME_ENVIRONMENT=sandbox   # or `api` for production

# ---------------------------------------------------------------------------
# Agent (cold path only)
# ---------------------------------------------------------------------------
# The Eve agent runs as its own server; route handlers reach it over HTTP.
# Start it with `pnpm eve:dev` (bare `eve dev` does not load .env.local).
EVE_SERVER_URL=http://127.0.0.1:2000

# Model access: either a direct Anthropic key...
ANTHROPIC_API_KEY=
# ...or Claude on Vertex AI, used when ANTHROPIC_API_KEY is empty.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
GOOGLE_VERTEX_PROJECT=your-gcp-project
GOOGLE_VERTEX_LOCATION=global

# Browser. Empty launches a local Chromium; set a CDP URL to drive a hosted
# browser (Kernel, Browserbase, or any Chromium exposing CDP).
BROWSER_CDP_URL=

# Development only, ignored when NODE_ENV=production: send the agent's real
# site URLs to the local form fixture instead.
# BROWSER_ORIGIN_OVERRIDE=https://www.ruhealth.org=http://localhost:4300
